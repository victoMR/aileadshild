[\"$\",\"a\",null,{\"href\":\"#integraciones\",\"children\":\"Integraciones\"}]}],[\"$\",\"li\",null,{\"children\":[\"$\",\"a\",null,{\"href\":\"#casos-exito\",\"children\":\"Casos de éxito\"}]}]]}]]}],[\"$\",\"div\",null,{\"className\":\"footer-col\",\"children\":[[\"$\",\"h5\",null,{\"children\":\"Empresa\"}],[\"$\",\"ul\",null,{\"children\":[[\"$\",\"li\",null,{\"children\":[\"$\",\"a\",null,{\"href\":\"#nosotros\",\"children\":\"Nosotros\"}]}],[\"$\",\"li\",null,{\"children\":[\"$\",\"a\",null,{\"href\":\"#contacto\",\"children\":\"Contacto\"}]}],[\"$\",\"li\",null,{\"children\":[\"$\",\"a\",null,{\"href\":\"#faq\",\"children\":\"FAQ\"}]}],[\"$\",\"li\",null,{\"children\":[\"$\",\"$Le\",null,{\"children\":\"Agendar Demo\"}]}]]}]]}],[\"$\",\"div\",null,{\"className\":\"footer-col\",\"children\":[[\"$\",\"h5\",null,{\"children\":\"Legal\"}],[\"$\",\"ul\",null,{\"children\":[[\"$\",\"li\",null,{\"children\":[\"$\",\"$Ld\",null,{\"href\":\"/privacy\",\"children\":\"Privacidad\"}]}],[\"$\",\"li\",null,{\"children\":\"$Lf\"}],\"$L10\"]}]]}]]}],\"$L11\"]}]}]\n5:[\"$\",\"$L12\",null,{\"children\":[\"$\",\"$13\",null,{\"name\":\"Next.MetadataOutlet\",\"children\":\"$@14\"}]}]\n6:[\"$\",\"h3\",null,{\"children\":\"4. Deslinde de Responsabilidad por Mal Uso\"}]\n7:[\"$\",\"p\",null,{\"children\":\"AI Lead Shield se deslinda de cualquier responsabilidad legal, civil o penal derivada del mal uso que el Usuario haga de la plataforma en contravención a estos términos.\"}]\n8:[\"$\",\"p\",null,{\"children\":\"Si se detecta un uso abusivo (Spam masivo, acoso o fraude), AI Lead Shield se reserva el derecho de suspender o rescindir el servicio de forma inmediata sin previo aviso y sin derecho a reembolso.\"}]\n9:[\"$\",\"div\",null,{\"className\":\"legal-panel legal-panel--neutral\",\"children\":[[\"$\",\"h3\",null,{\"children\":\"5. Activación del Servicio y Formulario de Onboarding\"}],[\"$\",\"ul\",null,{\"children\":[[\"$\",\"li\",null,{\"children\":\"Para dar inicio a la configuración personalizada, el Usuario debe completar el formulario de información técnica proporcionado tras el pago.\"}],[\"$\",\"li\",null,{\"children\":[[\"$\",\"strong\",null,{\"children\":\"Plazo de 7 días:\"}],\" El Usuario cuenta con un máximo de 7 días naturales posteriores a la realización del pago inicial para completar dicho formulario.\"]}],[\"$\",\"li\",null,{\"children\":[[\"$\",\"strong\",null,{\"children\":\"Inicio de Vigencia:\"}],\" Si transcurridos estos 7 días el formulario no ha sido llenado, el tiempo de la mensualidad contratada comenzará a correr automáticamente. Esto se debe a que la infraestructura y los recursos necesarios para el proyecto quedan reservados y asignados al Usuario desde el momento del pago.\"]}]]}]]}]\na:[\"$\",\"div\",null,{\"className\":\"legal-panel legal-panel--neutral\",\"children\":[[\"$\",\"h3\",null,{\"children\":\"6. Confidencialidad y Propiedad Intelectual\"}],[\"$\",\"h4\",null,{\"children\":\"6.1. Protección de la Tecnología de AI Lead Shield\"}],[\"$\",\"p\",null,{\"children\":\"Al contratar nuestros servicios, el Usuario/Cliente reconoce que todos los sistemas de automatización, arquitecturas de agentes de IA, flujos de trabajo (workflows), prompts especializados, scripts y metodologías implementadas son propiedad intelectual exclusiva de AI Lead Shield.\"}],[\"$\",\"p\",null,{\"children\":\"Queda estrictamente prohibido:\"}],[\"$\",\"ul\",null,{\"children\":[[\"$\",\"li\",null,{\"children\":\"Divulgar o compartir el acceso a nuestras herramientas, lógicas de automatización o agentes con terceros sin nuestra autorización previa y por escrito.\"}],[\"$\",\"li\",null,{\"children\":\"Copiar, replicar o realizar ingeniería inversa sobre los sistemas entregados.\"}],[\"$\",\"li\",null,{\"children\":\"Comercializar cualquier fragmento de nuestra tecnología como propia.\"}]]}],[\"$\",\"h4\",null,{\"children\":\"6.2. Privacidad y Datos de la Cuenta del Cliente\"}],[\"$\",\"p\",null,{\"children\":\"AI Lead Shield se compromete formalmente a no divulgar, vender ni compartir la información confidencial de la cuenta del Cliente (bases de datos de leads, estrategias comerciales o datos operativos). Toda la información suministrada por el Cliente será tratada bajo estrictos estándares de seguridad y utilizada únicamente para la ejecución técnica de los servicios contratados.\"}],[\"$\",\"h4\",null,{\"children\":\"6.3. Incumplimiento y Penalizaciones\"}],[\"$\",\"p\",null,{\"children\":\"El uso indebido o la divulgación no autorizada de nuestra propiedad intelectual constituye un incumplimiento grave de estos términos. En tal caso, AI Lead Shield se reserva el derecho de:\"}],[\"$\",\"ul\",null,{\"children\":[[\"$\",\"li\",null,{\"children\":[[\"$\",\"strong\",null,{\"children\":\"Suspensión Inmediata:\"}],\" Proceder al corte total o limitación técnica de los servicios, accesos y agentes de IA activos, sin previo aviso y sin derecho a reembolso.\"]}],[\"$\",\"li\",null,{\"children\":[[\"$\",\"strong\",null,{\"children\":\"Rescisión de Contrato:\"}],\" Terminar la relación comercial de forma definitiva.\"]}],[\"$\",\"li\",null,{\"children\":[[\"$\",\"strong\",null,{\"children\":\"Acciones Legales:\"}],\" Iniciar los procesos jurídicos correspondientes para la reclamación de daños y perjuicios derivados de la vulneración de secretos comerciales.\"]}]]}]]}]\nb:[\"$\",\"div\",null,{\"className\":\"legal-panel legal-panel--neutral\",\"children\":[[\"$\",\"h3\",null,{\"children\":\"7. Modificaciones\"}],[\"$\",\"p\",null,{\"children\":\"Nos reservamos el derecho de actualizar estos términos para adaptarlos a nuevas regulaciones técnicas o legales. La continuidad en el uso del servicio implica la aceptación de las actualizaciones.\"}]]}]\nc:[\"$\",\"p\",null,{\"className\":\"legal-footer-meta\",\"children\":\"Última actualización: martes 7 de octubre del año 2025\"}]\nf:[\"$\",\"$Ld\",null,{\"href\":\"/privacy#terminos\",\"children\":\"Términos\"}]\n10:[\"$\",\"li\",null,{\"children\":[\"$\",\"$Ld\",null,{\"href\":\"/privacy#reembolsos\",\"children\":\"Reembolsos\"}]}]\n11:[\"$\",\"div\",null,{\"className\":\"footer-bottom\",\"children\":[[\"$\",\"span\",null,{\"children\":[\"Copyright © \",2026,\" AI Lead Shield · Todos los derechos reservados\"]}],[\"$\",\"span\",null,{\"className\":\"font-mono\",\"children\":\"v6.0 · Hecho en Querétaro, MX\"}]]}]\n14:null\n","/privacy":"1:\"$Sreact.fragment\"\n2:I[39756,[\"/_next/static/chunks/0smljtry46fah.js\",\"/_next/static/chunks/0d3shmwh5_nmn.js\"],\"default\"]\n3:I[37457,[\"/_next/static/chunks/0smljtry46fah.js\",\"/_next/static/chunks/0d3shmwh5_nmn.js\"],\"default\"]\n4:[]\n0:{\"rsc\":[\"$\",\"$1\",\"c\",{\"children\":[null,[\"$\",\"$L2\",null,{\"parallelRouterKey\":\"children\",\"template\":[\"$\",\"$L3\",null,{}]}]]}],\"isPartial\":false,\"staleTime\":300,\"varyParams\":\"$W4\",\"buildId\":\"aReUiM__vz43tar6KCLOR\"}\n","/_index":"1:\"$Sreact.fragment\"\n2:I[22401,[\"/_next/static/chunks/0smljtry46fah.js\",\"/_next/static/chunks/0d3shmwh5_nmn.js\"],\"ClientLayout\"]\n3:I[39756,[\"/_next/static/chunks/0smljtry46fah.js\",\"/_next/static/chunks/0d3shmwh5_nmn.js\"],\"default\"]\n4:I[37457,[\"/_next/static/chunks/0smljtry46fah.js\",\"/_next/static/chunks/0d3shmwh5_nmn.js\"],\"default\"]\n:HL[\"/_next/static/chunks/120hn2076539i.css\",\"style\"]\n0:{\"rsc\":[\"$\",\"$1\",\"c\",{\"children\":[[[\"$\",\"link\",\"0\",{\"rel\":\"stylesheet\",\"href\":\"/_next/static/chunks/120hn2076539i.css\",\"precedence\":\"next\"}],[\"$\",\"script\",\"script-0\",{\"src\":\"/_next/static/chunks/0smljtry46fah.js\",\"async\":true}],[\"$\",\"script\",\"script-1\",{\"src\":\"/_next/static/chunks/0d3shmwh5_nmn.js\",\"async\":true}]],[\"$\",\"html\",null,{\"lang\":\"es\",\"className\":\"outfit_f4073d44-module__NfKI1W__variable jetbrains_mono_43d9fff9-module__vaV44a__variable inter_dc9473ec-module__UKqKMa__variable scroll-smooth antialiased\",\"data-scroll-behavior\":\"smooth\",\"children\":[[\"$\",\"head\",null,{\"children\":[[\"$\",\"meta